{
  "name": "@relay/desktop",
  "productName": "Relay",
  "private": true,
  "version": "0.1.2",
  "description": "Relay desktop shell",
  "author": "Relay",
  "main": "dist/main.js",
  "relay": {
    "webUrl": "https://192.168.21.155:4443",
    "updateUrl": "https://github.com/robinmxr/relay/releases/latest/download/",
    "pinnedCert": ""
  },
  "scripts": {
    "build": "tsc -p . && node scripts/prepare-build.mjs",
    "start": "tsc -p . && electron .",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsx --test test/*.test.ts",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@types/node": "^22.10.2",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
