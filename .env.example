# Copy to .env and adjust. Every value is optional.

# Server
PORT=4000
HOST=127.0.0.1

# Optional HTTPS listener for clients on other machines (huddles need a secure origin).
# Paths are relative to apps/server. One way to make a cert: mkcert -cert-file cert.pem -key-file key.pem <your-lan-ip> localhost
# RELAY_TLS_CERT=.data/tls/cert.pem
# RELAY_TLS_KEY=.data/tls/key.pem
# RELAY_HTTPS_PORT=4443

# Host port for the docker-compose Postgres (npm run db:up). Change it if 5432 is taken.
# RELAY_PG_PORT=5432

# Postgres. Leave unset to use the embedded PGlite database in apps/server/.data/pglite
# DATABASE_URL=postgres://relay:relay@localhost:5432/relay

# Redis for fan-out between several server processes. Leave unset for a single process.
# REDIS_URL=redis://localhost:6379

# Passwordless sign-in by email. Development only: anyone who knows an email can sign in as it.
RELAY_DEV_SIGNIN=true

# Desktop shell: where the web client is loaded from
# RELAY_WEB_URL=http://localhost:5173
